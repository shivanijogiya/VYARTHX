# Copy to .env to override defaults. Everything works without any key (deterministic demo mode).
DEMO_MODE=true
PORT=8000
# Optional: SQLite is the default. For Postgres: DATABASE_URL=postgresql+psycopg://user:pass@host/db
# DATABASE_URL=
# Optional LLM narration/phrasing only (never used for balances, approvals or safety decisions)
# ANTHROPIC_API_KEY=
# VYARTHX_LLM_MODEL=claude-haiku-4-5
# VYARTHX_LLM_VISION=false
# Free alternative: Google Gemini (key from https://aistudio.google.com/apikey). Used only if ANTHROPIC_API_KEY is empty.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# Optional: OSRM server for real road distances in route planning (otherwise haversine x1.3)
# OSRM_URL=http://localhost:5000
# Retries per agent tool call
# AGENT_MAX_RETRIES=2
